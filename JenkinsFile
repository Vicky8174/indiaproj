pipeline {
    agent any

    tools {
        jdk 'jdk'
        maven 'maven'
    }

    environment {
        DOCKERHUB_USER = "holyyyycow"
        IMAGE_NAME = "indiaproj"
        IMAGE_TAG = "1.0"
        FULL_IMAGE = "holyyyycow/indiaproj:1.0"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Cloning source code from GitHub'
                git branch: 'main',
                    credentialsId: 'mygithubcred',
                    url: 'https://github.com/Vicky8174/indiaproj.git'
            }
        }

        stage('Build JAR') {
            steps {
                echo 'Building Spring Boot JAR'
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker Image'
                bat 'docker build -t %FULL_IMAGE% .'
            }
        }

        stage('Push Docker Image to DockerHub') {
            steps {
                echo 'Pushing Docker Image'
                withCredentials([usernamePassword(
                        credentialsId: 'dockerhubpwd',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    bat '''
                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin
                        docker push %FULL_IMAGE%
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes (Minikube)') {
            steps {
                echo 'Deploying to Kubernetes'
                bat '''
                    minikube delete
                    minikube start --driver=docker

                    minikube image load %FULL_IMAGE%

                    kubectl delete deployment indiaproj-deployment --ignore-not-found
                    kubectl delete service indiaproj-service --ignore-not-found

                    kubectl apply -f deployment.yaml
                    kubectl apply -f services.yaml

                    kubectl get pods
                    kubectl get services

                    minikube addons enable dashboard

                    echo ==============================
                    echo MINIKUBE DASHBOARD URL
                    minikube dashboard --url
                    echo ==============================
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD + DOCKER + K8s DEPLOY SUCCESSFUL '
        }
        failure {
            echo 'PIPELINE FAILED '
        }
    }
}
